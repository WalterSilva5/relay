{
  "name": "relay-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Relay — shell Electron (tray, hotkeys, auto-update) sobre a web UI + sidecar Python",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "dev.relay.desktop",
    "productName": "Relay",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../local-client/dist-sidecar/",
        "to": "sidecar/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Relay <dev@relay.local>",
      "icon": "assets/icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "Relay"
        }
      },
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CHANGEME",
        "repo": "relay",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://github.com/WalterSilva5/relay",
  "author": "Relay",
  "desktopName": "Relay"
}
